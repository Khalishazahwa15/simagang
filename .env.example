APP_ENV=production

# Penggerak basis data: 'mysql' atau 'pgsql'.
DB_DRIVER=mysql

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=simagang_db
DB_USER=root
DB_PASS=

# Dua kunci berikut hanya dipakai bila DB_DRIVER=pgsql.
#
# DB_SSLMODE : Supabase menolak koneksi tanpa SSL, isi 'require'.
# DB_SCHEMA  : ruang tabel di dalam basis data. PostgreSQL memisahkan tabel
#              per schema, bukan per basis data seperti MySQL.
#
# Bila memakai Supabase, ambil koneksi "Session pooler" (port 5432).
# JANGAN memakai "Transaction pooler" (port 6543): mode transaksi pgbouncer
# tidak mendukung prepared statement sungguhan, sedangkan aplikasi ini
# menyetel PDO::ATTR_EMULATE_PREPARES = false. Koneksinya tetap berhasil,
# tetapi kueri mulai gagal acak begitu beban naik.
DB_SSLMODE=require
DB_SCHEMA=public

# Pengiriman email. Biarkan SMTP_HOST kosong untuk menulis email ke
# storage/logs/mail.log alih-alih benar-benar mengirimnya.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SIMAGANG Bappeda Lampung

# Kirim email otomatis setiap status pengajuan berubah.
# Isi false untuk mematikannya saat pengembangan.
MAIL_NOTIFIKASI=true
